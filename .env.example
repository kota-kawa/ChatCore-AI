# =============================================================================
# Chat-Core 環境変数テンプレート
# Chat-Core environment variable template
#
# 実際の値は `.env` に置き、git へは含めません。このファイルには安全な
# プレースホルダーだけを書きます。実行時に読まれる変数と本ファイルの記載が
# 一致しているかは `python3 scripts/check_env_documentation.py` で検証します。
#
# Put real values in `.env` and never commit it. This file carries safe
# placeholders only. Run `python3 scripts/check_env_documentation.py` to verify
# that this file and the variables actually read at runtime stay in sync.
# =============================================================================

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# 管理画面のログインパスワードのハッシュ。次のコマンドで生成します:
#   python3 -c "from services.security import hash_password; print(hash_password('your_admin_password_here'))"
# Docker Compose の `.env` で使う場合、ハッシュ内の `$` は `$$` にエスケープします。
# Password hash for the admin console. Generate it with the command above.
# When using it from a Docker Compose `.env`, escape `$` as `$$` inside the hash.
ADMIN_PASSWORD_HASH='pbkdf2_sha256$iterations$salt$hash'
# 管理画面ログインのIPあたり試行回数と計測ウィンドウ秒数。
# Per-IP attempt limit and measurement window (seconds) for admin console logins.
ADMIN_LOGIN_PER_IP_LIMIT=10
ADMIN_LOGIN_WINDOW_SECONDS=900

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
# 個別指定の接続情報。`DATABASE_URL` が設定されている場合はそちらが優先されます。
# Individual connection settings. `DATABASE_URL`, when set, takes precedence.
POSTGRES_USER=chatuser
POSTGRES_PASSWORD=chatpass
POSTGRES_DB=chat_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
# 接続URLを直接指定する場合（例: マネージドDB）。未設定なら上の項目から組み立てます。
# Set the connection URL directly (for example a managed database). Built from the fields above when unset.
DATABASE_URL=
# SQLAlchemy の発行SQLをログへ出すか。本番では有効にしないでください。
# Whether SQLAlchemy echoes the SQL it issues. Do not enable this in production.
SQLALCHEMY_ECHO=false
# 1ワーカーあたりの接続プールサイズ。`DB_POOL_MAX_CONN_PRODUCTION` は本番環境でのみ上書きに使います。
# Connection pool size per worker. `DB_POOL_MAX_CONN_PRODUCTION` overrides it only in production.
DB_POOL_MAX_CONN=10
DB_POOL_MAX_CONN_PRODUCTION=10
# プール枯渇時に接続確保を待つ上限秒数。超えると 503 + Retry-After を返す。
# Bounded wait (seconds) for acquiring a pooled connection; exceeding it yields 503 + Retry-After.
DB_POOL_ACQUIRE_TIMEOUT_SECONDS=10
# 503 応答に載せる Retry-After 秒数。
# The Retry-After value (seconds) sent with that 503 response.
DB_POOL_TIMEOUT_RETRY_AFTER_SECONDS=3
# プール内の接続を作り直す間隔（秒）。
# Interval (seconds) after which pooled connections are recycled.
DB_POOL_RECYCLE_SECONDS=1800
# 容量チェックで PostgreSQL 側に残しておく接続数の余裕。
# Connection headroom reserved on the PostgreSQL side by the capacity check.
DB_CONNECTION_HEADROOM=10
# Blue/Green で blue と green が同時稼働しうる場合は true。容量計算が2倍で見積もられます。
# Set to true when Blue/Green can run both colours at once; the capacity calculation then doubles.
BLUE_GREEN_DEPLOYMENT=false

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
# 接続URLを直接指定する場合。未設定なら下のホスト・ポート等から組み立てます。
# Set the connection URL directly; built from the host/port fields below when unset.
REDIS_URL=
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=generate_a_strong_redis_password_here
# Redis への接続確立に許容する秒数。短くして起動時のハングを避けます。
# Seconds allowed for establishing a Redis connection; keep it short to avoid startup hangs.
REDIS_CONNECT_TIMEOUT_SECONDS=1.0

# -----------------------------------------------------------------------------
# Scaling / Concurrency
# -----------------------------------------------------------------------------
# uvicorn のワーカープロセス数。CPUコアを使い切るために増やす。
# WEB_CONCURRENCY * DB_POOL_MAX_CONN < POSTGRES_MAX_CONNECTIONS を必ず満たすこと
# （Blue/Green では blue+green が同時稼働しうるので 2 * WEB_CONCURRENCY * DB_POOL_MAX_CONN で見積もる）。
# Number of uvicorn worker processes; raise to use all CPU cores.
# Keep WEB_CONCURRENCY * DB_POOL_MAX_CONN < POSTGRES_MAX_CONNECTIONS
# (size for 2 * WEB_CONCURRENCY * DB_POOL_MAX_CONN under Blue/Green, where both colors overlap).
WEB_CONCURRENCY=2
# 1ワーカーあたりのブロッキングI/O（同期DB・外部HTTP等）の同時実行上限。
# Per-worker concurrency budget for blocking I/O (sync DB, outbound HTTP, etc.).
RUN_BLOCKING_MAX_WORKERS=64
# 1ワーカーあたりの同時 SSE ストリーム数の上限（接続ごとに1スレッドを占有する）。
# Per-worker ceiling on concurrent SSE streams; each stream holds one thread for its lifetime.
SSE_STREAM_MAX_WORKERS=256
# 非同期の要約・タイトル・埋め込みなどを処理する背景スレッド数。
# Number of background threads that run asynchronous summaries, titles and embeddings.
BACKGROUND_WORKER_THREADS=8
# 共有HTTPセッションのコネクションプールサイズ（外部API呼び出し用）。
# Connection pool size for the shared outbound HTTP session.
HTTP_POOL_MAXSIZE=32
# アプリが待ち受けるポート番号（ローカル起動時）。
# Port the application listens on when started locally.
PORT=5004

# -----------------------------------------------------------------------------
# Postgres tuning (passed to the postgres container as -c flags)
# -----------------------------------------------------------------------------
# 容量チェックのために Python 側でも読みます。コンテナ側の max_connections と同じ値にしてください。
# Also read by Python for the capacity check; keep it equal to the container's max_connections.
POSTGRES_MAX_CONNECTIONS=150
# 以下は docker-compose が postgres の起動引数へ展開するチューニング値です（Python 側では読みません）。
# The values below are expanded by docker-compose into the postgres startup arguments; Python never reads them.
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB
POSTGRES_WORK_MEM=16MB
POSTGRES_MAINTENANCE_WORK_MEM=128MB
# この時間(ms)を超えるクエリをスロークエリとしてログ出力する。
# Log queries slower than this many milliseconds as slow queries.
POSTGRES_LOG_MIN_DURATION_MS=500

# Redis のメモリ上限。maxmemory-policy は volatile-lru 固定（TTL付きキーのみ退避）。
# docker-compose が redis の起動引数へ展開します（Python 側では読みません）。
# Redis memory ceiling; the policy is fixed to volatile-lru (only keys with a TTL are evicted).
# Expanded by docker-compose into the redis startup arguments; Python never reads it.
REDIS_MAXMEMORY=4gb

# -----------------------------------------------------------------------------
# Security / Session
# -----------------------------------------------------------------------------
# セッション Cookie の署名鍵。環境ごとに異なる十分に長いランダム値を設定します。
# Signing key for the session cookie. Use a long random value, different per environment.
FASTAPI_SECRET_KEY=generate_a_strong_secret_key_here
# `production` のときデバッグを無効化し、本番向けの Cookie 属性とプール設定を使います。
# When set to `production`, debug is disabled and production cookie attributes and pool settings apply.
FASTAPI_ENV=production
# None keeps the session available for Google OAuth callbacks; production also sets Secure.
# None は Google OAuth のコールバックでセッションを維持するために必要です。本番では Secure も付きます。
FASTAPI_SESSION_SAMESITE=none
# `X-Forwarded-For` / `X-Real-IP` を信頼できるプロキシのIP・CIDR（カンマ区切り）。
# Comma-separated proxy IPs/CIDRs allowed to supply `X-Forwarded-For` / `X-Real-IP`.
TRUSTED_PROXY_IPS=127.0.0.1,::1
# フロントエンドの公開URL。Cookie ドメイン、リダイレクト先、Passkey の既定値の算出に使います。
# Public URL of the frontend; used for the cookie domain, redirect targets and Passkey defaults.
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Passkey / WebAuthn
# -----------------------------------------------------------------------------
# 同じ概念に対して `WEBAUTHN_*` と `PASSKEY_*` の2系統が読まれます（`services/passkeys.py`）。
# 優先順位は次のとおりです。片方だけ設定すれば足ります。
#   RP ID / RP 名: WEBAUTHN_RP_ID -> PASSKEY_RP_ID、WEBAUTHN_RP_NAME -> PASSKEY_RP_NAME
#   許可オリジン : PASSKEY_ORIGINS -> WEBAUTHN_ORIGINS
# コード側の命名統一は別課題です。ここでは実際の読み取り順をそのまま記載します。
# Two naming families, `WEBAUTHN_*` and `PASSKEY_*`, are read for the same concepts
# (`services/passkeys.py`). The precedence is:
#   RP ID / RP name: WEBAUTHN_RP_ID -> PASSKEY_RP_ID, WEBAUTHN_RP_NAME -> PASSKEY_RP_NAME
#   Allowed origins: PASSKEY_ORIGINS -> WEBAUTHN_ORIGINS
# Setting one family is enough. Unifying the names in code is tracked separately.
#
# RP ID: サイトのドメイン名（例: chatcore-ai.com）。未設定時は FRONTEND_URL のホスト名を使用。
# プロキシ構成の場合は必ず明示的に設定すること。
# RP ID: the site domain. Falls back to the FRONTEND_URL host; always set it explicitly behind a proxy.
WEBAUTHN_RP_ID=chatcore-ai.com
PASSKEY_RP_ID=
# 認証器に表示される表示名。未設定時は "Chat Core"。
# Display name shown by the authenticator; defaults to "Chat Core".
WEBAUTHN_RP_NAME=Chat Core
PASSKEY_RP_NAME=
# 許可オリジン: カンマ区切りで複数指定可能。未設定時は FRONTEND_URL から自動生成。
# Allowed origins, comma-separated. Derived from FRONTEND_URL when unset.
PASSKEY_ORIGINS=
WEBAUTHN_ORIGINS=
# Passkey 認証のIPあたり試行回数（オプション取得・検証）と計測ウィンドウ秒数。
# Per-IP attempt limits for Passkey option requests and verifications, plus the measurement window (seconds).
PASSKEY_AUTH_OPTIONS_PER_IP_LIMIT=30
PASSKEY_AUTH_VERIFY_PER_IP_LIMIT=30
PASSKEY_AUTH_WINDOW_SECONDS=300

# -----------------------------------------------------------------------------
# Google OAuth
# -----------------------------------------------------------------------------
# Google Cloud コンソールで発行した OAuth クライアント情報。
# OAuth client credentials issued in the Google Cloud console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_PROJECT_ID=
GOOGLE_JS_ORIGIN=https://chatcore-ai.com
GOOGLE_REDIRECT_URI=https://chatcore-ai.com/google-callback

# -----------------------------------------------------------------------------
# LLM providers
# -----------------------------------------------------------------------------
# 各プロバイダの APIキー。モデル名からプロバイダを自動判別するため、使うモデルの分だけ設定します。
# API keys per provider. The provider is inferred from the model name, so set only the ones you use.
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# 出力トークン上限。対応モデルはいずれも思考トークンをこの枠に含めるため、
# 小さすぎる値は「回答が途中で切れる」「回答がすごく短い」の直接の原因になる。
# 未設定ならコード側の既定値（services/llm.py）が使われる。値を書く場合は既定値以上にすること。
# Output-token caps. Every supported model counts reasoning tokens against these, so a value
# that is too small directly causes truncated and very short answers. Leaving them unset uses
# the defaults in services/llm.py; if you set them, do not go below those defaults.
LLM_MAX_TOKENS=16384
# 最終回答と継続生成の出力枠。長い調査回答を1パスで書き切れる大きさにする。
# Output budget for the final answer and its continuations: large enough to finish a long
# research answer in one pass.
LLM_MAX_TOKENS_ANSWER=32768
# LLM 呼び出しの再試行回数（通常呼び出しとストリーミング）。
# Retry counts for LLM calls, for the normal call and for streaming.
LLM_MAX_RETRIES=2
LLM_STREAM_MAX_RETRIES=2
# 入力側の文脈予算。モデル別に上書きしたい場合は `LLM_CONTEXT_WINDOW_<MODEL>` を使います
# （モデル名から名前を組み立てるため、この一覧には個別の行を持ちません）。
# Input-side context budget. To override it per model, use `LLM_CONTEXT_WINDOW_<MODEL>`
# (the name is built from the model name, so this list has no individual line for it).
LLM_CONTEXT_WINDOW_TOKENS=65536
# 文脈上限に対して残す安全マージンと、ツール定義ぶんとして見積もるトークン数。
# Safety margin left against the context limit, and the tokens budgeted for tool definitions.
LLM_CONTEXT_SAFETY_MARGIN_TOKENS=2048
LLM_TOOL_SCHEMA_OVERHEAD_TOKENS=64
# 最終回答リクエストの入力トークン上限。超えそうな場合は古い根拠から圧縮する。
# Input-token budget for the answer request; older evidence is compacted before it overflows.
LLM_FINAL_ANSWER_INPUT_TOKEN_BUDGET=48000
# 出力上限で切れた最終回答を続ける最大回数。
# Maximum number of continuation passes for an output-limited final answer.
LLM_FINAL_ANSWER_MAX_CONTINUATIONS=3
# 埋め込みモデルと、意味検索でヒットとみなす最大距離（0 < 値 <= 2.0）。
# Embedding model, and the maximum distance still treated as a semantic-search hit (0 < value <= 2.0).
EMBEDDING_MODEL=text-embedding-3-small
SEMANTIC_MAX_DISTANCE=0.75

# -----------------------------------------------------------------------------
# Chat agent (research loop)
# -----------------------------------------------------------------------------
# 調査ループの予算。推論ターンとツール実行を別々に数える。共有カウンタにすると
# 検索が増えるたびに推論ターンが減り、調査が深いターンほど統合が痩せる。
# Research-loop budget. Reasoning turns and tool calls are counted separately: a shared
# counter makes every extra search cost a reasoning turn, starving the deepest turns.
CHAT_AGENT_MAX_LLM_TURNS=6
CHAT_AGENT_MAX_TOOL_CALLS=6
# 推論ターンとツール実行の合計ステップ上限（両方を一括で絞りたい場合）。
# Combined step ceiling for reasoning turns and tool calls, when you want a single knob.
CHAT_AGENT_MAX_STEPS=12

# -----------------------------------------------------------------------------
# Web search (Brave Search)
# -----------------------------------------------------------------------------
# Brave Search の APIキー。未設定ならWeb検索は無効として扱われます。
# Brave Search API key. Web search is treated as unavailable when it is unset.
BRAVE_API_KEY=
# Web検索そのもの、ページ本文の取得、リンク追跡の有効・無効。
# Enable flags for web search itself, page-body fetching and link following.
CHAT_WEB_SEARCH_ENABLED=1
CHAT_WEB_SEARCH_FETCH_PAGES=1
CHAT_WEB_SEARCH_FOLLOW_LINKS=1
# Brave Search のリクエストパラメータ（件数、国、言語、タイムアウト秒）。
# Brave Search request parameters: result count, country, language and timeout in seconds.
BRAVE_SEARCH_COUNT=10
BRAVE_SEARCH_COUNTRY=JP
BRAVE_SEARCH_LANG=
BRAVE_SEARCH_TIMEOUT_SECONDS=12.0
# Brave Search の結果からLLMへ渡す量の上限（スニペット数、URL数、トークン数）。
# Caps on how much of the Brave Search result is handed to the LLM: snippets, URLs and tokens.
BRAVE_SEARCH_MAX_SNIPPETS=18
BRAVE_SEARCH_MAX_SNIPPETS_PER_URL=4
BRAVE_SEARCH_MAX_URLS=6
BRAVE_SEARCH_MAX_TOKENS=4096
# 抽出の厳しさ。`balanced` のほか Brave が受け付ける値を指定できます。
# Extraction strictness; accepts `balanced` and the other values Brave supports.
BRAVE_SEARCH_THRESHOLD=balanced
# 本文取得の対象件数と、1ページから取り込む最大文字数。
# How many results have their body fetched, and the character cap taken from one page.
WEB_SEARCH_FETCH_TOP_N=2
WEB_SEARCH_PAGE_TEXT_MAX_CHARS=4000
# リンク追跡の深さ、総ページ数、目標ページ数、全体タイムアウト秒。
# Link-following depth, total page count, target page count and overall timeout in seconds.
WEB_SEARCH_LINK_FOLLOW_MAX_DEPTH=3
WEB_SEARCH_LINK_FOLLOW_MAX_PAGES=10
WEB_SEARCH_LINK_FOLLOW_TARGET_PAGES=5
WEB_SEARCH_LINK_FOLLOW_TIMEOUT_SECONDS=30.0

# -----------------------------------------------------------------------------
# Quotas / Rate limits
# -----------------------------------------------------------------------------
# LLM API の1日あたり上限（全利用者合計）。
# Daily LLM API limit (all users combined).
LLM_DAILY_API_LIMIT=300
# 画面操作AIエージェントの月あたり上限（全利用者合計）。
# Monthly support AI agent API limit (all users combined).
AI_AGENT_MONTHLY_API_LIMIT=1000
# Web検索の月あたり上限（全利用者合計）。
# Monthly Brave web search limit (all users combined).
BRAVE_WEB_SEARCH_MONTHLY_LIMIT=1000
# 認証メール送信の1日あたり上限（全利用者合計）。
# Daily auth email send limit (all users combined).
AUTH_EMAIL_DAILY_SEND_LIMIT=50
# 未ログイン利用者のチャット1日あたり上限（接続元IPごと）。
# Daily guest chat limit (per client IP).
GUEST_CHAT_DAILY_LIMIT=10
# 認証メール送信の短期制限: 同一アドレスの再送間隔（秒）、アドレス単位・IP単位の回数、計測ウィンドウ秒数。
# Short-term auth email limits: resend cooldown (seconds), per-address and per-IP counts, and the measurement window.
AUTH_EMAIL_COOLDOWN_SECONDS=60
AUTH_EMAIL_PER_EMAIL_LIMIT=5
AUTH_EMAIL_PER_IP_LIMIT=10
AUTH_EMAIL_WINDOW_SECONDS=600
# 確認コード入力の試行制限: アドレス単位・IP単位の回数と計測ウィンドウ秒数。
# Verification-code attempt limits: per-address and per-IP counts, plus the measurement window (seconds).
VERIFICATION_ATTEMPT_PER_EMAIL_LIMIT=10
VERIFICATION_ATTEMPT_PER_IP_LIMIT=60
VERIFICATION_ATTEMPT_WINDOW_SECONDS=3600

# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------
# Resend の APIキーと差出人アドレス。どちらも未設定だとメール送信は失敗します。
# Resend API key and sender address; sending fails unless both are set.
RESEND_API_KEY=
RESEND_FROM_ADDRESS=no-reply@example.com

# -----------------------------------------------------------------------------
# MCP (Model Context Protocol)
# -----------------------------------------------------------------------------
# MCP サーバー機能を有効にするか。
# Whether the MCP server surface is enabled.
MCP_ENABLED=false
# 外部クライアントへ知らせる公開ベースURL。OAuth のメタデータとリダイレクトに使います。
# Public base URL advertised to external clients; used for OAuth metadata and redirects.
MCP_PUBLIC_BASE_URL=
# MCP エンドポイントで許可する Host と Origin（カンマ区切り）。
# Comma-separated Host and Origin values allowed on the MCP endpoints.
MCP_ALLOWED_HOSTS=
MCP_ALLOWED_ORIGINS=
# OAuth トークンを暗号化する Fernet 鍵（カンマ区切りで鍵のローテーションが可能。先頭が現行鍵）。
# 生成例: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Fernet keys used to encrypt OAuth tokens; comma-separated to allow rotation, the first being current.
# Generate one with the command above.
MCP_OAUTH_ENCRYPTION_KEYS=
# 認可エンドポイントと動的クライアント登録のレート制限。
# Rate limits for the authorize endpoint and for dynamic client registration.
MCP_AUTHORIZE_RATE_LIMIT_PER_10_MINUTES=30
MCP_DCR_RATE_LIMIT_PER_HOUR=20
# MCP 経由の公開操作のレート制限（時間あたり・日あたり）。
# Rate limits for publishing through MCP, per hour and per day.
MCP_PUBLISH_RATE_LIMIT_PER_HOUR=500
MCP_PUBLISH_RATE_LIMIT_PER_DAY=5000
# 機械向けエンドポイントが受け付けるリクエスト本文の最大バイト数。
# Maximum request body size (bytes) accepted by the machine-facing endpoints.
MCP_MACHINE_MAX_BODY_BYTES=8388608
# クライアント情報メタデータ（CIMD）のキャッシュ件数と同時取得数。
# Cache entry count and concurrent fetch limit for client information metadata documents.
MCP_CIMD_CACHE_ENTRIES=256
MCP_CIMD_MAX_CONCURRENT_FETCHES=4

# -----------------------------------------------------------------------------
# Uploads
# -----------------------------------------------------------------------------
# 公開プロンプトの添付画像の保存先。相対パスならリポジトリ基準で解決します。
# Storage directory for prompt-share attachments; a relative path resolves against the repository root.
PROMPT_SHARE_UPLOAD_DIR=
# 利用者1人あたりの添付画像の合計容量上限（バイト）。
# Per-user total size cap for prompt-share attachments, in bytes.
PROMPT_SHARE_ATTACHMENT_USER_QUOTA_BYTES=104857600

# -----------------------------------------------------------------------------
# Logging / Observability
# -----------------------------------------------------------------------------
# ログのレベルと出力形式（`json` または `text`）。
# Log level and output format (`json` or `text`).
LOG_LEVEL=INFO
LOG_OUTPUT=json
# ログの出力ディレクトリと、アプリログ・エラーログのファイル名。
# Log output directory, plus the application and error log file names.
LOG_DIR=logs
APP_LOG_FILE=app.log
ERROR_LOG_FILE=error.log
# ログの1ファイルあたり最大バイト数と、保持する世代数。
# Maximum bytes per log file and how many rotated files are kept.
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=10

# -----------------------------------------------------------------------------
# Frontend (Next.js build / client only - Python never reads these)
# -----------------------------------------------------------------------------
# 本番サイトのURL（末尾スラッシュなし）。canonical URL・sitemap・OG URLに使用。
# Production site URL without a trailing slash; used for canonical URLs, the sitemap and OG URLs.
NEXT_PUBLIC_SITE_URL=https://chatcore-ai.com
# X(Twitter)の公式アカウントがあれば設定（例: @chatcoreai）。未設定でも動作する。
# Official X (Twitter) account, if any; the site works without it.
NEXT_PUBLIC_TWITTER_SITE=
# Google Analytics の測定ID。未設定なら計測タグを読み込みません。
# Google Analytics measurement ID; the tag is not loaded when it is unset.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
